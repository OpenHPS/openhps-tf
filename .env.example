# Copy to .env and adjust. Real environment variables always win over this file.

# --- Remote GPU box (used by scripts/) -------------------------------------
# Training runs in Docker, so the box needs only Docker + nvidia-container-toolkit
# + an NVIDIA driver. No system CUDA, no sudo, no matching Node version.
REMOTE_HOST=192.168.1.5
REMOTE_USER=maxim
REMOTE_DIR=workspace/openhps-tf
REMOTE_IMAGE=openhps-tf-train:1.0

# Which GPU the training container may use, in docker --gpus device=... syntax.
# tfjs-node-gpu is pinned to libtensorflow-gpu 2.9.1 (CUDA 11.2) which supports
# Ampere (sm_86) at most. The RTX 5060 Ti (sm_120/Blackwell) CANNOT run it.
# srv3: 0,1 = RTX 5060 Ti (unsupported by tfjs-node-gpu)  2 = RTX 3060 Ti (sm_86)
REMOTE_GPUS=2

# --- Training --------------------------------------------------------------
# Epochs per sub-model (autoencoder, accuracy, radio map) and where the model
# is saved inside the repo (relative to the repo root).
EPOCHS=250
MODEL_DIR=test/data/model

# Training batch size (larger = much better GPU utilisation for this tiny
# model) and early-stopping patience in epochs (0 disables early stopping).
BATCH_SIZE=256
PATIENCE=20

# Ensemble size: trains N independent models (different splits/inits) and
# averages their predictions. ENSEMBLE=3 gives ~6-8% lower prediction error
# than a single model (member i>0 is saved to <MODEL_DIR>_i).
ENSEMBLE=3

# Name of this run (used for the container name and the local log copy).
RUN_NAME=default
